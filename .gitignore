.env
.env.local
.env.*.local
# Production environment files and ad-hoc copies must never become Git
# candidates. The deployed checkout keeps .env.prod beside the Compose file;
# backup/save suffixes are covered too.
.env.prod*
node_modules
.turbo
.next
# Next.js alternate distDir outputs used by verification/debug builds.
# These can contain gigabytes of machine-local webpack caches.
apps/web/.next-*/
dist
coverage
apps/api/db/generated
apps/api/internal/gen
packages/proto-gen/hajj
*.log
.DS_Store
apps/api/uploads/
apps/web/public/sw.js
apps/web/public/sw.js.map
apps/web/public/swe-worker-*.js
apps/web/public/swe-worker-*.js.map

# Local-only clutter — never committed, never deployed
tawafiqhub-landing-page/
tawafiqhub-subdomain/
.pnpm-store/
.claude/
UI*.png
*.pdf
Safrat New Updates.md
.next-e2e

# Playwright: reports, traces, and the auth states (real session cookies)
apps/web/playwright-report/
apps/web/test-results/
apps/web/e2e/.auth/
# Screenshots from the rendering spec — evidence for whoever ran it, not
# something to carry in the repository.
apps/web/e2e/.screens/
apps/web/e2e/tsconfig.tsbuildinfo

# Compiled Go binary — build output, never a source artefact.
apps/api/server

# TypeScript incremental build state. Machine-specific and rewritten on every
# build, so tracking it produces a conflict on every parallel change.
*.tsbuildinfo
.next-verify/
