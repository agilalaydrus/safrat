# Database
DATABASE_URL="postgresql://safrat:password@localhost:5432/safrat"

# Redis (tier-recalculation worker — apps/api/cmd/worker)
REDIS_URL="redis://localhost:6380"

# Better Auth (generate: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="https://app.safrat.com"

# Google Sign-In (Better Auth social provider) — Google Cloud Console >
# APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# App URLs
NEXT_PUBLIC_APP_URL="https://app.safrat.com"
NEXT_PUBLIC_API_URL="https://api.safrat.com"

# S3-compatible storefront media. The browser receives only a 10-minute PUT
# URL; credentials stay in the API. Local MinIO defaults are shown below.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="safrat-uploads"
S3_ACCESS_KEY_ID="safrat-local"
S3_SECRET_ACCESS_KEY="safrat-local-secret"
S3_PUBLIC_BASE_URL="http://localhost:9000/safrat-uploads"
S3_FORCE_PATH_STYLE="true"
# Per-travel limit for live files plus unfinished upload reservations.
STOREFRONT_STORAGE_QUOTA_MB="250"

# Production self-hosted MinIO only. Use different strong secrets for the
# root administrator and the bucket-scoped API service user above.
MINIO_ROOT_USER="safrat-root"
MINIO_ROOT_PASSWORD=""

# Cloudflare R2 aliases are also supported for backwards compatibility:
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# R2_PUBLIC_BASE_URL="https://assets.tawafiqhub.id"

# Notifications — Firebase Console: Project Settings
# Service account JSON is server-only (apps/api) — Project Settings > Service Accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Web config + Web Push certificate are client-safe (apps/web) — Project Settings > General / Cloud Messaging
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Email — verified sender address must belong to a domain verified in
# Resend; falls back to onboarding@resend.dev (Resend's sandbox sender,
# only deliverable to the Resend account's own email) when unset.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Xendit (Module 7 — Orders & Payments, apps/api only). Without
# XENDIT_SECRET_KEY, OrderService.CreateOrder fails fast with a clear
# error instead of creating an order nobody can pay for. Webhook URL to
# register in the Xendit Dashboard: {api origin}/webhooks/xendit —
# XENDIT_WEBHOOK_TOKEN must match the "Verification Token" shown there.
XENDIT_SECRET_KEY=""
XENDIT_WEBHOOK_TOKEN=""
# Source addresses permitted to deliver a payment webhook (IPs or CIDRs,
# comma-separated) — Xendit's published egress ranges.
#
# Left empty, deliveries are accepted from any address and the API warns about
# it at startup. That is deliberate: failing closed would stop every payment
# settling the moment this went missing or Xendit changed its ranges, which is
# worse than a wider surface sitting behind two stronger controls (the callback
# token, and settling from Xendit's own API rather than from the delivery).
#
# Keep in step with the allowlists in deploy/nginx/safrat.conf and
# deploy/caddy/Caddyfile.
# Ask Xendit support for these — they are not published in their documentation
# (confirmed 2026-08-27). Their dashboard's "IP Allowlist" is about inbound API
# calls from you to them, which is a different thing.
XENDIT_WEBHOOK_ALLOWED_IPS=""

# Observability
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
AXIOM_DATASET=""
AXIOM_TOKEN=""

# Bank account operators send manual subscription transfers to. Shown next to
# the unique amount — the amount alone is useless without somewhere to send it.
SUBSCRIPTION_BANK_NAME="BCA"
SUBSCRIPTION_BANK_ACCOUNT="1234567890"
SUBSCRIPTION_BANK_HOLDER="PT TawafiqHub Indonesia"

# Encrypts KYC identity numbers (NIK, NPWP) before they reach the database, so
# a stolen disk, dump or replica carries none of them in the clear.
#
# 32 random bytes, base64-encoded. Generate with:
#   openssl rand -base64 32
#
# Without it the application still starts and serves everything else, but KYC
# submissions are REFUSED rather than saved unencrypted — storing an identity
# number in the clear because a variable was missing is the exact failure this
# prevents, and it would look like success until a breach made it obvious.
#
# Losing this key means losing every identity number encrypted with it: there is
# no recovery path by design.
#
# Where to keep it:
#   - A password manager is the right home for a small team. Encrypted, synced,
#     and recoverable through a master password you already protect.
#   - A sealed offline copy as a second line — a printed sheet in a safe is
#     unfashionable and works.
#   - NOT on the VPS beside the database backups. Whoever takes that machine
#     would get the data and the key that opens it in one go, which is exactly
#     the outcome encrypting it was meant to prevent.
#
# Finding it again: the API prints a fingerprint of the loaded key at startup —
# eight hex characters of a SHA-256 over it, which identify the key without
# revealing it. Every sealed record stores the fingerprint of the key that
# sealed it, so a candidate key found later can be checked against the data
# before being deployed. A mismatch is reported loudly at startup rather than
# discovered one unreadable record at a time.
KYC_ENCRYPTION_KEY=""
