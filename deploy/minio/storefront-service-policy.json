{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::safrat-uploads"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::safrat-uploads"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "storefront/",
            "storefront/*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::safrat-uploads/storefront/*",
        "arn:aws:s3:::safrat-uploads/storefront-pending/*"
      ]
    }
  ]
}
