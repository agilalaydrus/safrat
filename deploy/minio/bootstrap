#!/bin/sh
set -eu

: "${MINIO_ROOT_USER:?MINIO_ROOT_USER is required}"
: "${MINIO_ROOT_PASSWORD:?MINIO_ROOT_PASSWORD is required}"
: "${S3_BUCKET:?S3_BUCKET is required}"
: "${S3_ACCESS_KEY_ID:?S3_ACCESS_KEY_ID is required}"
: "${S3_SECRET_ACCESS_KEY:?S3_SECRET_ACCESS_KEY is required}"

if [ "${S3_BUCKET}" != "safrat-uploads" ]; then
  echo "S3_BUCKET must remain safrat-uploads unless the versioned policies are updated" >&2
  exit 1
fi

until mc alias set local http://minio:9000 "${MINIO_ROOT_USER}" "${MINIO_ROOT_PASSWORD}" >/dev/null 2>&1; do
  sleep 2
done

mc mb --ignore-existing "local/${S3_BUCKET}"

# Re-running `user add` rotates the service user's secret in place, making a
# credential update and a normal deploy follow the same idempotent path.
mc admin user add local "${S3_ACCESS_KEY_ID}" "${S3_SECRET_ACCESS_KEY}"

mc admin policy create local safrat-storefront /config/storefront-service-policy.json
mc admin policy attach local safrat-storefront --user "${S3_ACCESS_KEY_ID}"

mc anonymous set-json /config/published-read-policy.json "local/${S3_BUCKET}"

# Do not duplicate the rule every time minio-init is reconciled. Published
# objects live under storefront/, so this rule cannot expire live media.
lifecycle_config="$(mc ilm rule ls --json "local/${S3_BUCKET}" 2>/dev/null || true)"
case "${lifecycle_config}" in
  *'"Expiration":{"Days":1}'*'"Prefix":"storefront-pending/"'*) ;;
  *) mc ilm rule add --prefix "storefront-pending/" --expire-days 1 "local/${S3_BUCKET}" ;;
esac

mc ready local
echo "MinIO storefront storage reconciled"
