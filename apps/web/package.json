{
  "name": "@hajj-saas/web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:clean": "psql \"$DATABASE_URL\" -c \"DELETE FROM operators WHERE slug = 'e2e-fixture'; DELETE FROM \\\"user\\\" WHERE email IN ('e2e-operator@safrat.local', 'e2e-pilgrim@safrat.local');\"",
    "e2e:pwa:build": "NEXT_DIST_DIR=.next-e2e NEXT_PUBLIC_APP_URL=http://127.0.0.1:3141 NEXT_PUBLIC_API_URL=http://127.0.0.1:8141 next build",
    "e2e:pwa:serve": "NEXT_DIST_DIR=.next-e2e BETTER_AUTH_URL=http://127.0.0.1:3141 NEXT_PUBLIC_APP_URL=http://127.0.0.1:3141 NEXT_PUBLIC_API_URL=http://127.0.0.1:8141 next start --port 3141",
    "e2e:pwa:api": "cd ../api && PORT=8141 CORS_ALLOWED_ORIGIN=http://127.0.0.1:3141 go run ./cmd/server",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.0",
    "@connectrpc/connect": "^1.6.1",
    "@connectrpc/connect-web": "^1.6.1",
    "@hajj-saas/proto-gen": "workspace:*",
    "@sentry/nextjs": "^10.70.0",
    "@serwist/next": "^9.5.12",
    "@tabler/icons-react": "^3.46.0",
    "better-auth": "^1.6.28",
    "firebase": "^12.17.1",
    "lucide-react": "^1.33.0",
    "next": "15.5.23",
    "papaparse": "^5.6.0",
    "pg": "^8.23.0",
    "react": "19.0.3",
    "react-dom": "19.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "serwist": "^9.5.12",
    "tailwindcss": "^4.0.0"
  }
}
